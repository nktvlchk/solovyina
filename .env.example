# Copy to .env for local runs. Never commit .env. On Railway set these as Variables.

# Required
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# Optional: enables /check, "Як сказати?" and the model fallback.
# Without it the bot still works (dictionary, Wiktionary, MyMemory).
ANTHROPIC_API_KEY=your_anthropic_api_key
LLM_MODEL=claude-haiku-4-5-20251001
LLM_DAILY_LIMIT=500
LLM_USER_DAILY_LIMIT=60

# Optional: official Google Cloud Translation API key (fallback translator)
GOOGLE_TRANSLATE_API_KEY=

# Only for a retired bot: answer everything with "moved to @new_bot"
REDIRECT_TO_BOT=

# Optional: numeric Telegram IDs allowed to use /stats (comma-separated)
ADMIN_IDS=123456789

# Optional: turn the teacher's posts in the class chat into deck cards.
# The bot does not reply in that chat. Leave the token and gist id empty to disable.
# GITHUB_TOKEN needs only the gist scope.
GITHUB_TOKEN=
DECK_GIST_ID=
DECK_GIST_FILE=deck.md
# Numeric Telegram user ids of the teacher, comma-separated.
TEACHER_IDS=
# The same chat id the drip worker posts to, for example -1001234567890.
DRIP_CHAT_ID=
DRIP_START=2026-10-08
DRIP_TZ=Europe/Lisbon

# Storage (SQLite). Keep it outside git; on Railway point it to a volume.
DATABASE_PATH=data/runtime/bot.sqlite3
STORE_RAW_TEXT=false
RETENTION_DAYS=180

# Limits
MAX_INPUT_LENGTH=1000
MAX_TTS_LENGTH=300
USER_RATE_LIMIT_PER_MINUTE=20
MAX_CONCURRENT_REQUESTS=8

LOG_LEVEL=INFO
